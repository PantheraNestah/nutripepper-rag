# Copy to .env and fill in. Only the providers used by your tiers need a key.
APP_NAME=NutriPepper Backend
APP_VERSION=1.0.0
DEBUG=True

# ── LLM providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Tier -> model mapping: provider:model[:effort]  (effort: off|low|medium|high|max)
# Defaults shown. See app/services/llm.py.
# LLM_MODEL_COMPLEX=anthropic:claude-sonnet-5-5:medium
# LLM_MODEL_MEDIUM=anthropic:claude-haiku-5-5:medium
# LLM_MODEL_EASY=anthropic:claude-haiku-5-5:medium
#
# DeepSeek-only example (no Anthropic key needed). "deepseek-flash" is served by
# DeepSeek-V4.1-Flash-1017; effort is low | high | max (off = thinking disabled).
# LLM_MODEL_COMPLEX=deepseek:deepseek-flash:high
# LLM_MODEL_MEDIUM=deepseek:deepseek-flash:low
# LLM_MODEL_EASY=deepseek:deepseek-flash:low

# Anthropic server-side refusal fallback for claude-sonnet-5-5 (set false to disable)
# ANTHROPIC_REFUSAL_FALLBACK=true
# Anthropic prompt caching of the system prompt (set false to disable)
# ANTHROPIC_PROMPT_CACHE=true
